# Dependencies
/vendor/
# Commit the root lock so CI installs exact versions and its cache key resolves;
# nested third-party library locks stay local.
composer.lock
!/composer.lock
# Composer binary: use the system / CI-provided composer (setup-php), never vendor the 3.6MB phar.
composer.phar

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Build artifacts
phpcs-report.txt
phpcs-report.json

# WordPress
wp-config.php

# Temporary
/tmp/

# Runtime cache (regenerable from the remote source; keeps the repo lean)
# actor-scanner downloads gfriends Filetree and normalizes it here on force-refresh.
includes/modules/actor-scanner/data/gfriends-index.json

# One-off ops runbooks (may contain live credentials — never commit)
w2p-cleanup-rollback.md

# Agent workspace / tooling
.workbuddy/
# .agent/ is tracked (agent rules & skills); only SKILL.md files are committed —
# auxiliary skill content (evals / references / scripts) is local dev material.
.agent/skills/*/evals/
.agent/skills/*/references/
.agent/skills/*/scripts/

# Backup files
*.bak*
wpgenius-backup*.zip
# Translation template backups (e.g. wp-genius-backup-20260831.pot~)
*.pot~
