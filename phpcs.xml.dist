<?xml version="1.0"?>
<ruleset name="WP Genius Coding Standards">
    <description>WordPress Coding Standards for WP Genius plugin.</description>

    <!-- What to scan -->
    <file>.</file>

    <!-- Exclude directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.agent/*</exclude-pattern>
    <exclude-pattern>*/.vscode/*</exclude-pattern>

    <!-- Bundled third-party code: not scanned / not auto-fixed -->
    <exclude-pattern>*/includes/csf/*</exclude-pattern>
    <exclude-pattern>*/includes/modules/post-duplicator/includes/*</exclude-pattern>
    <exclude-pattern>*/includes/modules/post-duplicator/m4c-postduplicator.php</exclude-pattern>
    <exclude-pattern>*/includes/modules/smart-aui/library/*</exclude-pattern>
    <exclude-pattern>*/includes/modules/word-to-post/library/*</exclude-pattern>

    <!-- Exclude specific files -->
    <exclude-pattern>composer.json</exclude-pattern>
    <exclude-pattern>composer.lock</exclude-pattern>
    <exclude-pattern>phpcs.xml.dist</exclude-pattern>
    <exclude-pattern>*.pot</exclude-pattern>
    <exclude-pattern>*.pot~</exclude-pattern>

    <!-- Use WordPress Coding Standards -->
    <rule ref="WordPress-Extra">
        <!-- Exclude short prefix check - legacy "w2p" prefix needs refactoring -->
        <exclude name="WordPress.NamingConventions.PrefixAllGlobals"/>
        <!-- Exclude file name check - legacy file naming convention -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- Pure style rules (team preference, not correctness/security) -->
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
        <exclude name="WordPress.DateTime.RestrictedFunctions.date_date"/>
        <exclude name="Universal.Operators.DisallowShortTernary"/>
        <exclude name="Squiz.PHP.CommentedOutCode"/>
        <exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
        <exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
        <exclude name="Generic.CodeAnalysis.AssignmentInCondition"/>
        <exclude name="WordPress.PHP.NoSilencedErrors"/>

        <!-- Deliberate direct system-function usage in tooling/services layers:
             file logging (W2P logger services), cURL multi-download (smart-aui),
             mysqli external DB (cms-migrator), base64 codec (W2P_Crypto),
             error_log (W2P_Logger backend), runtime ini_set, custom cron interval. -->
        <exclude name="WordPress.WP.AlternativeFunctions"/>
        <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_error_log"/>
        <exclude name="WordPress.PHP.DevelopmentFunctions.error_log_print_r"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.urlencode_urlencode"/>
        <exclude name="WordPress.DB.RestrictedClasses.mysql__mysqli"/>
        <exclude name="WordPress.PHP.IniSet"/>
        <exclude name="WordPress.WP.CronInterval"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.system_calls_shell_exec"/>
        <exclude name="Generic.PHP.DeprecatedFunctions"/>
        <exclude name="WordPress.PHP.DiscouragedPHPFunctions.rand_mt_rand"/>
    </rule>

    <!-- Use PHP Compatibility -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP">
        <include-pattern>*.php</include-pattern>
    </rule>

    <!-- Sniff properties -->
    <config name="minimum_wp_version" value="5.0"/>

    <!-- Text Domain check -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wp-genius"/>
            </property>
        </properties>
    </rule>

    <!-- Prefix check -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="w2p"/>
                <element value="wp_genius"/>
                <element value="WP_Genius"/>
            </property>
        </properties>
    </rule>

    <!-- Show progress and colors -->
    <arg value="ps"/>
    <arg name="colors"/>

    <!-- Report format -->
    <arg name="report" value="full"/>

    <!-- Use UTF-8 encoding -->
    <arg name="encoding" value="utf-8"/>
</ruleset>
